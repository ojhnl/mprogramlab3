// Мигание светодиода на пине 13 по прерыванию Timer1 (режим CTC).
// Секунду горит, секунду не горит. Кнопка не используется.

const int PIN_LED = 13;

// Прерывание таймера: срабатывает раз в секунду и переключает светодиод
ISR(TIMER1_COMPA_vect) {
  digitalWrite(PIN_LED, !digitalRead(PIN_LED));
}

void setup() {
  pinMode(PIN_LED, OUTPUT);

  cli();                                 // отключить глобальные прерывания
  TCCR1A = 0;                            // обнулить регистры управления Timer1
  TCCR1B = 0;
  OCR1A = 15624;                         // 16 МГц / 1024 = 15625 Гц; 1 с = 15625 отсчётов, минус 1
  TCCR1B |= (1 << WGM12);                // режим CTC (сброс по совпадению)
  TCCR1B |= (1 << CS10) | (1 << CS12);   // делитель 1024
  TIMSK1 |= (1 << OCIE1A);               // включить прерывание по совпадению
  sei();                                 // включить глобальные прерывания
}

void loop() {
  // пусто: мигание полностью делает прерывание таймера
}